users = {}

while True:
    print("\n1. Login")
    print("2. Sign Up")
    print("3. Exit")

    choice = input("Choose: ")

    if choice == "2":
        print("\n--- SIGN UP ---")

        first_name = input("First name: ").strip()
        last_name = input("Last name: ").strip()

        phone = input("Phone: ").strip()
        while len(phone) != 10 or not phone.isdigit():
            print("Phone must be 10 digits")
            phone = input("Phone: ").strip()

        username = input("Username: ").strip()
        while not username.islower() or not username.strip() or " " in username:
            print("Username must contain only lowercase letters and no spaces")
            username = input("Username: ").strip()

        email = input("Email: ").strip()
        while "@" not in email or "." not in email.split("@")[-1]:
            print("Invalid email")
            email = input("Email: ").strip()

        if email in users:
            print("This email already exists. Please login.")
            continue

        password = input("Password: ")
        while len(password) < 8 or not any(x.isdigit() for x in password):
            print("Password must have 8 characters and a number")
            password = input("Password: ")

        confirm = input("Confirm password: ")

        if password == confirm:
            users[email] = {
                "username": username,
                "password": password,
                "first_name": first_name,
                "last_name": last_name,
                "phone": phone
            }
            print("Sign up successful!")
        else:
            print("Passwords do not match!")

    elif choice == "1":
        print("\n--- LOGIN ---")

        username = input("Username: ").strip()
        email = input("Email: ").strip()
        password = input("Password: ")

        if email in users:
            user = users[email]
            if user["username"] == username and user["password"] == password:
                print("Login successful!")
                print("Welcome", user["first_name"])
            else:
                print("Wrong username or password")
        else:
            print("Account not found. Please sign up.")

    elif choice == "3":
        print("Thank you!")
        break

    else:
        print("Invalid choice")
